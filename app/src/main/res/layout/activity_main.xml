<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tunnel Lite"
            android:textColor="#000000"
            android:textSize="24sp"
            android:layout_marginBottom="16dp" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSni"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Usar SNI" />

            <RadioButton
                android:id="@+id/rbPayload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Usar Payload" />
        </RadioGroup>

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Host / IP"
            android:inputType="textUri"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Porta"
                android:inputType="number"
                android:text="443" />

            <EditText
                android:id="@+id/etUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="2"
                android:hint="Usuário"
                android:inputType="text"
                android:singleLine="true" />
        </LinearLayout>

        <EditText
            android:id="@+id/etPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Senha"
            android:inputType="textPassword"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etSni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SNI (Server Name Indication)"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etPayload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Payload (ex: GET / HTTP/1.1[crlf]Host: [host][crlf][crlf])"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="CONECTAR" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Desconectado"
            android:textColor="#0B57D0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#444444"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>
